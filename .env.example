BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=
ENABLE_VULNERABLE_DEMO=0
WEBGUARD_ALLOWED_HOSTS=localhost,127.0.0.1
